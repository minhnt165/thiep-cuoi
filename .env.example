# Lưu trữ: "file" (mặc định, ghi vào thư mục data/) hoặc "supabase"
STORE=file
# Thư mục dữ liệu khi STORE=file (mặc định ./data)
# DATA_DIR=./data

# Khi STORE=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# Địa chỉ công khai của site, dùng cho link chia sẻ và ảnh xem trước
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Mã phải nhập khi tạo thiệp mới (nên đặt trên site thật để chặn tạo rác). Để trống = ai cũng tạo được.
# CREATE_CODE=abc123

# Khối "mời tác giả cốc cà phê" ở cuối trang chủ (VietQR). Để trống = ẩn khối.
# Mã BIN ngân hàng xem src/lib/banks.ts (970441 = VIB)
DONATE_BANK_CODE=970441
DONATE_ACCOUNT=161113
DONATE_HOLDER=NGUYEN TRONG MINH
DONATE_NOTE=Ca phe cho tac gia
